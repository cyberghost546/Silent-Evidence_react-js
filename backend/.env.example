# ---------------------------------------------------------------
# The live site's settings for Django. Type these into your host's
# "Environment" page (Render: your service -> Environment).
# NEVER commit the real values - this file only shows the names.
# On your own computer you need NONE of these.
# ---------------------------------------------------------------

# Off on the live site (shows your code to anyone when on).
DJANGO_DEBUG=false

# A long random secret. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Django's own address (without https://).
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com

# The React site's address (with https://). Several: comma-separated.
FRONTEND_ORIGINS=https://your-site.vercel.app

# Used in emails, the sitemap and robots.txt.
SITE_URL=https://your-site.vercel.app

# The Postgres database (your host shows this address).
DATABASE_URL=postgres://user:password@host:5432/dbname

# How many proxies sit between the visitor and Django (see
# "Real IP addresses" in DEPLOY.md). Vercel -> Render is usually 2.
TRUSTED_PROXY_COUNT=2

# Real email (leave EMAIL_HOST out to keep printing emails instead).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Silent Evidence <no-reply@your-domain.com>

# Only for the AI Generator and AI Toxicity Queue.
ANTHROPIC_API_KEY=

# Phone notifications (web push). Leave empty = switched off.
# Make a pair ONCE with:  python manage.py make_push_keys
# (making new ones later means every phone must switch them on again)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@yourdomain.com
