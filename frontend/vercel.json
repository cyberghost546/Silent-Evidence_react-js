{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/media/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://YOUR-BACKEND.onrender.com/static/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://YOUR-BACKEND.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://YOUR-BACKEND.onrender.com/robots.txt"
    },
    {
      "source": "/((?!assets/|icons/|sw\\.js|manifest\\.webmanifest|offline\\.html|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
