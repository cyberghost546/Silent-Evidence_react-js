{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://YOUR-BACKEND.onrender.com/media/:path*" },
    { "source": "/admin/:path*", "destination": "https://YOUR-BACKEND.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://YOUR-BACKEND.onrender.com/static/:path*" },
    { "source": "/sitemap.xml", "destination": "https://YOUR-BACKEND.onrender.com/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://YOUR-BACKEND.onrender.com/robots.txt" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
