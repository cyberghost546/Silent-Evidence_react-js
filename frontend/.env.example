# ---------------------------------------------------------------
# Settings for the React build. Copy this file to ".env.production"
# (or type them into your host's "Environment Variables" page).
# Only variables starting with VITE_ reach the browser - so NEVER put
# a secret here: everyone can read the built JavaScript.
# ---------------------------------------------------------------

# Where Django is. Empty = "this same site": the host forwards /api
# to Django (see vercel.json and DEPLOY.md). Leave it out on your own
# computer - then it's http://localhost:8000.
VITE_API_URL=
